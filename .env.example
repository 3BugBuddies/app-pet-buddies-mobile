EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_API_BASE_URL=

# Liga as telas de pontos (lê saldo, extrato e memória do Java). Sem isso, o app mostra o "Em breve".
# EXPO_PUBLIC_PONTOS=api
# Mostra o detalhe do cálculo: o "O que contou" do extrato do tutor e quanto o responsável ganhou no atendimento
# concluído do vet. Precisa do MongoDB do .NET configurado; sem isso, fica escondido e o vet vê só "Pontos enviados".
# EXPO_PUBLIC_PONTOS_DETALHE=on
